{
  "expo": {
    "name": "DateTech",
    "slug": "DateTech",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon2.png",
    "scheme": "datetech",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.rosn.DateTech"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/icon2.png",
          "imageWidth": 76
        }
      ],
      "expo-app-blocker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.example.DateTech.ShieldConfiguration",
                  "targetName": "ShieldConfiguration",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.expo.app-blocker"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.example.DateTech.ShieldAction",
                  "targetName": "ShieldAction",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.expo.app-blocker"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.example.DateTech.DeviceActivityMonitor",
                  "targetName": "DeviceActivityMonitor",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.expo.app-blocker"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "93ebfdd9-4c75-42b5-9075-8938280d2217"
      }
    }
  }
}
